# ─────────────────────────────────────────────
# VERTX Platform — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Django Core
SECRET_KEY=your-secret-key-minimum-50-chars-change-this-in-production
DJANGO_DEBUG=True
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_ENGINE=postgres
DB_NAME=vertx_db
DB_USER=vertx_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# CORS (add your frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS S3 (for thumbnails/assets)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=vertx-assets
AWS_S3_REGION_NAME=us-east-1

# Cloudflare Stream (for video)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/webhook/mpesa/
MPESA_API_BASE_URL=https://sandbox.safaricom.co.ke
